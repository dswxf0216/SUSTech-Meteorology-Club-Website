# 本地开发保持 sqlite；正式环境改为 postgres。
DATABASE_TYPE=sqlite
DATABASE_URL=file:./club-cms.db
# 仅在修改本地内容模型、需要自动同步表结构时临时设为 true。
PAYLOAD_DB_PUSH=false
PAYLOAD_SECRET=请替换为至少32位的随机字符串
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# 多个可信来源使用英文逗号分隔；通常留空即可。
ALLOWED_ORIGINS=

# PostgreSQL（DATABASE_TYPE=postgres 时启用）
# DATABASE_URL=postgresql://club_user:请替换密码@localhost:5432/club_website
POSTGRES_DB=club_website
POSTGRES_USER=club_user
POSTGRES_PASSWORD=请替换为高强度数据库密码

# SMTP（填写 SMTP_HOST 后启用，可用于后台账号找回密码）
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=南方科技大学气象社
