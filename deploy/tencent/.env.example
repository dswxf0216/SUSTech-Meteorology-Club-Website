# Do not use example values in production. Never commit the real .env.
APP_IMAGE=
# Select a tested image compatible with the source database (PG 17 or earlier
# uses the data mount below; PG 18+ requires reviewing its changed mount layout).
POSTGRES_IMAGE=
# Generate a random hexadecimal password to avoid URL-encoding problems.
POSTGRES_PASSWORD=
# Preserve Railway's existing value during migration. Do not paste into chat.
PAYLOAD_SECRET=
# Exact origin, no trailing slash. Configure HTTPS before admin login.
SITE_URL=
